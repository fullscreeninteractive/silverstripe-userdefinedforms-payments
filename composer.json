{
    "name": "a2nt/userdefinedforms-payments",
    "description": "SilverStripe Userdefined Forms Payments",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "userdefinedforms",
        "payment",
        "omnipay"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Tony Air",
            "email": "tony@twma.pro"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/cms": "^6.1",
        "silverstripe/userforms": "^7",
        "dnadesign/silverstripe-elemental-userforms": "^5",
        "silverstripe/silverstripe-omnipay": "^6",
        "php-http/guzzle7-adapter": "^1.1",
        "stripe/stripe-php": "^13 || ^14"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11",
        "cambis/silverstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "A2nt\\UserFormsPayments\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "analyse:fix": "phpstan analyse --memory-limit=512M --level 9 --fix",
        "lint": "phpcs --standard=PSR12 src",
        "lint:fix": "phpcbf --standard=PSR12 src"
    },
    "extra": {
        "expose": [
            "css"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
